# Cache Control Headers for Cloudflare
# Place this file in the root of your repository for Cloudflare Pages

# Global headers for all files
/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  
  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  
  # CORS Headers
  Access-Control-Allow-Origin: *
  
  # Security - HSTS (enable for HTTPS sites)
  # Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache static assets aggressively
/css/*
  Cache-Control: public, max-age=31536000, immutable
  
/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images with long TTL but allow revalidation
/images/*
  Cache-Control: public, max-age=2592000, must-revalidate

# HTML files - shorter cache for frequent updates
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Prevent caching of service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  
# Preload critical resources link headers
/
  Link: </images/hero.webp>; rel=preload; as=image; type=image/webp; fetchpriority=high
  Link: </css/styles.css>; rel=preload; as=style
  Link: </js/main.js>; rel=preload; as=script
